index 0000000..cfb2401
--- /dev/null
+++ b/internal/pool/bindprofile.go
@@ -0,0 +1,66 @@
+// 会话粘性首绑画像（internal/session 的 Config.Profiles 数据源）。
+// 与 AvailableUIDsForModelRealm 的候选口径完全一致（realm 过滤 + healthy[ForModel]
+// + 在途占满过滤），额外暴露两个粘性首绑需要的维度：
+//   - Capacity 承载容量：在途上限口径（并发额度是上游对单号最硬的约束，
+//     用它当会话容量，负载才能摊到与各号真实额度成比例）；
+//   - Quality 质量分：weightOf 三因子（credits 比例 + 快过期占比 + 闲置补偿）×
+//     手写权重，与 pick 的短名单权重同源同口径（全集 maxCredits 基准）。
+package pool
+
+import (
+	"sort"
+	"time"
+)
+
+// BindProfile 单账号的粘性首绑画像。
+type BindProfile struct {
+	UID      string
+	Capacity float64
+	Quality  float64
+}
+
+// sessionNominalCapacity 在途不设上限（inFlightLimit<=0）时的名义会话容量。
+// 上限无限时各号容量本就不可比，给同一名义值即可：水位由「已绑会话数」主导，
+// 质量分在并列层内决胜——这正是无限额池子的正确语义。
+const sessionNominalCapacity = 8.0
+
+// BindProfilesForModelRealm 返回该 (model, realm) 域内可绑定账号的首绑画像，
+// 按 UID 排序（稳定输出，便于上层确定性测试）。model 为空时健康口径退化为
+// 账号级 healthy（与 AvailableUIDsForRealm 一致）。
+func (p *Pool) BindProfilesForModelRealm(model, realm string) []BindProfile {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	now := time.Now()
+	health := func(e *entry) bool { return e.healthy(now) }
+	if model != "" {
+		health = func(e *entry) bool { return e.healthyForModel(now, model) }
+	}
+	var cands []*entry
+	var maxCredits int64
+	for _, e := range p.byUID {
+		if realm != "" && e.a.Realm() != realm {
+			continue
+		}
+		if !health(e) || p.inFlightFull(e) {
+			continue
+		}
+		cands = append(cands, e)
+		if e.credits > maxCredits {
+			maxCredits = e.credits
+		}
+	}
+	out := make([]BindProfile, 0, len(cands))
+	for _, e := range cands {
+		capacity := float64(p.inFlightLimit(e))
+		if capacity <= 0 {
+			capacity = sessionNominalCapacity
+		}
+		out = append(out, BindProfile{
+			UID:      e.a.UID,
+			Capacity: capacity,
+			Quality:  p.weightOf(e, maxCredits, now),
+		})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UID < out[j].UID })
+	return out
+}
