+func pickWeightedProfile(cands []BindProfile, randHook func(n int64) int64) string {
+	const scale = 1_000_000
+	weights := make([]int64, len(cands))
+	var total int64
+	for i, c := range cands {
+		wi := int64(c.Quality*scale + 0.5)
+		if wi < 1 {
+			wi = 1
+		}
+		weights[i] = wi
+		total += wi
+	}
+	rnd := rand.Int64N
+	if randHook != nil {
+		rnd = randHook
+	}
+	r := rnd(total)
+	var acc int64
+	for i := range cands {
+		acc += weights[i]
+		if r < acc {
+			return cands[i].UID
+		}
+	}
+	return cands[len(cands)-1].UID
+}
