@@ -0,0 +1,132 @@
+package session
+
+import (
+	"testing"
+	"time"
+)
+
+// profilesOf 构造画像闭包（UID 顺序即决胜层顺序；池侧输出按 UID 升序，同口径）。
+func profilesOf(ps ...BindProfile) func(string) []BindProfile {
+	return func(string) []BindProfile { return ps }
+}
+
+// randFirst 恒选层内第一个候选（确定性）：加权抽签 r=0 → 累计第一个区间命中。
+func randFirst(int64) int64 { return 0 }
+
+// TestHeadroomSpreadsByCapacity：高质量号不能超容量承接，余量满了必须让位。
+// 推演（容量均 3、rand 恒取层内首个）：c1→a1(层=全体)、c2→a1(h 2≥best3−1)、
+// c3→a2(a1 h=1 出层)、c4→a1(h 2)、c5→a2(a1 h=0 出层)、c6→a3。
+// 期望 a1=3(=容量，不超载)、a2=2、a3=1——质量优先但被容量封顶。
+func TestHeadroomSpreadsByCapacity(t *testing.T) {
+	r := New(Config{
+		TTL:       time.Minute,
+		Store:     newCountingStore(),
+		Available: func() []string { return []string{"a1", "a2", "a3"} },
+		Profiles: profilesOf(
+			BindProfile{UID: "a1", Capacity: 3, Quality: 1e9}, // 质量碾压
+			BindProfile{UID: "a2", Capacity: 3, Quality: 1},
+			BindProfile{UID: "a3", Capacity: 3, Quality: 1},
+		),
+		RandInt64N: randFirst,
+	})
+	counts := map[string]int{}
+	for _, key := range []string{"c1", "c2", "c3", "c4", "c5", "c6"} {
+		uid, ok := r.ResolveForModel(key, "m")
+		if !ok {
+			t.Fatalf("resolve %s failed", key)
+		}
+		counts[uid]++
+	}
+	want := map[string]int{"a1": 3, "a2": 2, "a3": 1}
+	for uid, n := range want {
+		if counts[uid] != n {
+			t.Fatalf("account %s bound %d, want %d (all: %v)", uid, counts[uid], n, counts)
+		}
+	}
+}
+
+// TestHeadroomQualityDecidesTiedTier：容量并列（同水位层）时质量分决胜。
+func TestHeadroomQualityDecidesTiedTier(t *testing.T) {
+	r := New(Config{
+		TTL:       time.Minute,
+		Store:     newCountingStore(),
+		Available: func() []string { return []string{"a1", "a2"} },
+		Profiles: profilesOf(
+			BindProfile{UID: "a1", Capacity: 8, Quality: 1e9},
+			BindProfile{UID: "a2", Capacity: 8, Quality: 1},
+		),
+		RandInt64N: randFirst,
+	})
+	uid, ok := r.ResolveForModel("c1", "m")
+	if !ok || uid != "a1" {
+		t.Fatalf("quality should win tied tier: uid=%s ok=%v", uid, ok)
+	}
+}
+
+// TestHeadroomToleranceExcludesOverloaded：余量落后超过 1 个槽位的高分号必须出局
+// ——质量不允许牺牲一个会话槽位。
+func TestHeadroomToleranceExcludesOverloaded(t *testing.T) {
+	r := New(Config{
+		TTL:       time.Minute,
+		Store:     newCountingStore(),
+		Available: func() []string { return []string{"a1", "a2"} },
+		Profiles: profilesOf(
+			BindProfile{UID: "a1", Capacity: 8, Quality: 1e9},
+			BindProfile{UID: "a2", Capacity: 8, Quality: 1},
+		),
+		RandInt64N: randFirst,
+	})
+	// a1 预绑 3 个会话（余量 5），a2 空闲（余量 8）：差距 3 > 容差 1 → a1 出层。
+	r.Bind("k1", "a1")
+	r.Bind("k2", "a1")
+	r.Bind("k3", "a1")
+	uid, ok := r.ResolveForModel("c-new", "m")
+	if !ok || uid != "a2" {
+		t.Fatalf("overloaded high-quality account must lose: uid=%s ok=%v", uid, ok)
+	}
+}
+
+// TestProfilesNilFallsBackToHash：未注入画像时回落双段哈希——结果与 hashIndex
+// 逐位一致、同键稳定（老配置零回归）。
+func TestProfilesNilFallsBackToHash(t *testing.T) {
+	r := New(Config{
+		TTL:       time.Minute,
+		Store:     newCountingStore(),
+		Available: func() []string { return []string{"a1", "a2", "a3"} },
+	})
+	uids := []string{"a1", "a2", "a3"} // 全空闲 → 空闲段 = 全池，直接哈希取模
+	u1, ok := r.ResolveForModel("c1", "m")
+	if !ok {
+		t.Fatal("resolve failed")
+	}
+	if want := uids[hashIndex("c1", len(uids))]; u1 != want {
+		t.Fatalf("fallback should equal legacy hash: got %s want %s", u1, want)
+	}
+	if u2, _ := r.ResolveForModel("c1", "m"); u2 != u1 {
+		t.Fatalf("same key should stay bound: %s vs %s", u1, u2)
+	}
+}
+
+// TestHeadroomCountsOnlyActiveBindings：TTL 已过期、尚未被 GC 的绑定不占水位
+// ——旧会话不该永远压低该号余量。
+func TestHeadroomCountsOnlyActiveBindings(t *testing.T) {
+	r := New(Config{
+		TTL:       10 * time.Millisecond,
+		Store:     newCountingStore(),
+		Available: func() []string { return []string{"a1", "a2"} },
+		Profiles: profilesOf(
+			BindProfile{UID: "a1", Capacity: 2, Quality: 1e9},
+			BindProfile{UID: "a2", Capacity: 2, Quality: 1},
+		),
+	})
+	r.Bind("old-1", "a1")
+	r.Bind("old-2", "a1")
+	time.Sleep(25 * time.Millisecond) // 让绑定 TTL 过期（GC 尚未跑）
+	uid, ok := r.ResolveForModel("fresh", "m")
+	if !ok {
+		t.Fatal("resolve failed")
+	}
+	if uid != "a1" {
+		t.Fatalf("expired bindings should not hold capacity: got %s", uid)
+	}
+}
