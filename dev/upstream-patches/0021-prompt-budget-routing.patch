+// 压缩请求（把整段历史发上去做摘要）反复撞同一个 400，客户端就再也压不动了。
+func TestChatPromptTooLongAccountCapRotatesToAnotherAccount(t *testing.T) {
+	const raw = `{"code":11115,"msg":"prompt is too long: 100001 tokens \u003e 100000 maximum","requestId":"req-cap"}`
+	calls := map[string]int{}
+	up := newFakeUpstream(t, func(authz string) (int, string, bool) {
+		calls[authz]++
+		if authz == "Bearer at-cap" {
+			return http.StatusBadRequest, raw, false
+		}
+		return http.StatusOK, sseOK, true
+	})
+	p := testPoolWith(
+		&auth.Auth{UID: "cap", AccessToken: "at-cap", ExpiresAt: 9999999999},
+		&auth.Auth{UID: "wide", AccessToken: "at-wide", ExpiresAt: 9999999999},
+	)
+	h := NewHandler(Config{Pool: p, Upstream: up})
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, httptest.NewRequest("POST", "/v1/chat/completions",
+		strings.NewReader(`{"model":"glm-5.2","stream":true,"messages":[{"role":"user","content":"hi"}]}`)))
+	if rec.Code != http.StatusOK {
+		t.Fatalf("code=%d body=%s want 200 (rotate when the cap is account-level)", rec.Code, rec.Body)
+	}
+	if calls["Bearer at-cap"] != 1 || calls["Bearer at-wide"] != 1 {
+		t.Fatalf("calls=%v want cap:1 wide:1 (rotate exactly once)", calls)
+	}
+	// 账号级上限不是账号故障：不冷却/不禁用。
