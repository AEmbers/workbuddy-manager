+// parsePromptMaxTokens 从 11115 原文里取"上报的最大 token 数"（"100001 tokens
+// \u003e 100000 maximum" 里的 100000），取不到返回 ok=false（调用方按真超限处理，
+// 不轮转）。不用正则：原文是 JSON，'>' 可能被转义成 \u003e（转义串里还带数字 003）
+// 甚至双重转义，所以取 maximum 前紧邻的那段连续数字，别把转义里的数位算进去。
+func parsePromptMaxTokens(body string) (int64, bool) {
+	j := strings.Index(body, " maximum")
+	if j < 0 {
+		return 0, false
+	}
+	end := j
+	for end > 0 && body[end-1] == ' ' {
+		end--
+	}
+	k := end
+	for k > 0 && body[k-1] >= '0' && body[k-1] <= '9' {
+		k--
+	}
+	if k == end {
+		return 0, false
+	}
+	v, err := strconv.ParseInt(body[k:end], 10, 64)
+	if err != nil {
+		return 0, false
+	}
+	return v, true
+}
+
+// hasOtherAvailableUID 判断可用号集合里是否还有本轮没试过的号（tried 已含当前
+// 失败号）——换号前先确认"还有别的号可试"，避免把 400 变成 503。
+func hasOtherAvailableUID(uids []string, tried map[string]bool) bool {
+	for _, uid := range uids {
+		if !tried[uid] {
+			return true
+		}
+	}
+	return false
+}
